# Environment variables the code reads. Secrets are referenced through SOPS (fresnel/docs L0 secrets); never put values here.
# FRESNEL_DEV=1 turns the dev wire round-trip checks on even in a compiled binary (apps/cli/src/dev-mode.ts)
FRESNEL_DEV=0
# FRESNEL_TEST_DISK_TMP=1 keeps bun test temp dirs on disk instead of /dev/shm (xeon/scripts/test-preload.ts, eng.testing.guide TS-07)
FRESNEL_TEST_DISK_TMP=0
# Optional path overrides without a default (FRESNEL_HOME is the engine home: config, data, state; FRESNEL_CLI_STATE_FILE is the CLI position file),
# and names that only appear as test fixture strings (packages/platform-secrets/test/env-filter.test.ts):
# ws-check-ignore: FRESNEL_HOME FRESNEL_CLI_STATE_FILE FRESNEL_SCENARIO_TAPE FRESNEL_SCENARIO_COMMAND EXA_API_KEY FRESNEL_MAX_TOOLS ProgramFiles WSL_DISTRO_NAME FRESNEL_TEST_SECRET_VALUE KEEP_ME
# 모델 테이프 녹화기(packages/core-models/scripts/record-tape.ts)가 읽는 키. 값은 user 범위 저장소: secrets run user -- just tape-record …
ANTHROPIC_API_KEY=
# 셸 목업 개발 서버 포트와 정적 빌드 출력 폴더(xeon/apps/desktop/mockups/vite.config.ts). 출력 기본값은 <tmpdir>/fresnel-mockups/<이름>
MOCKUP_PORT=5180
MOCKUP_OUT=
# 프레임 격리 e2e가 쓸 WebView(apps/desktop/test/e2e/frame-isolation.e2e.test.ts): chrome 또는 webkit. 비우면 기기에 맞게 고른다
FRESNEL_E2E_WEBVIEW_BACKEND=
# FRESNEL_WEB_E2E_VERBOSE=1이면 웹 게이트웨이 e2e(apps/desktop/test/web-e2e, just web-e2e)가 서비스·게이트웨이의 stderr를 터미널에 보인다
FRESNEL_WEB_E2E_VERBOSE=0
# 시험 대역만 읽는 이름(apps/host/test/fixtures): Helm 번들 경로, MCP 시험 서버가 받은 env를 되돌려 주는 키
# ws-check-ignore: FRESNEL_TEST_HELM_BUNDLE GH_TOKEN LOG_LEVEL
# 데스크톱 측정(xeon/scripts/desktop-benchmark.ts)이 찾는 cargo 빌드 폴더. 비우면 <캐시>/fresnel/cargo-target이다
CARGO_TARGET_DIR=
# Stagehand 브라우저 엔진이 쓸 Chrome 경로. 비우면 표준 위치에서 찾는다
CHROME_PATH=
# FRESNEL_HOOK_ID is set by the external hook runner for its child process; nothing reads it from the environment of the engine (packages/ext-host/src/operations/hooks/env.ts)
FRESNEL_HOOK_ID=
# Electron 셸이 읽는 UI 번들 폴더(xeon/apps/desktop-shell/src/main.ts). 비우면 개발 중에는 `just desktop-ui` 출력, 묶은 앱에서는 Resources/ui
FRESNEL_UI_DIR=
# 시험 대역만 읽는 이름(apps/desktop-shell/test/engine/launcher.test.ts): 자식 대역이 받은 줄을 남길 파일
# ws-check-ignore: PROBE_LOG
# Electron 묶음 출력 폴더(xeon/apps/desktop-shell/scripts/package.ts). 비우면 apps/desktop-shell/dist-app
FRESNEL_APP_OUT=
# 묶은 앱에 적을 릴리스 버전(같은 파일). 비우면 package.json 버전, 앞의 v는 뗀다
FRESNEL_RELEASE_VERSION=
# 묶은 앱의 업데이트 피드에 쓸 GitHub 릴리스 저장소 owner/repo(xeon/apps/desktop-shell/scripts/package.ts). 비우면 피드 없이 묶는다
FRESNEL_UPDATE_REPO=
