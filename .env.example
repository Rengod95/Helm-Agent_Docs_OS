# Environment variables the code reads. Secrets are referenced through SOPS (xeon/docs L0 secrets); never put values here.
# XEON_DEV=1 turns the dev wire round-trip checks on even in a compiled binary (apps/cli/src/dev-mode.ts)
XEON_DEV=0
# Optional path overrides without a default (XEON_HOME is the engine home: config, data, state; XEON_CLI_STATE_FILE is the CLI position file),
# and names that only appear as test fixture strings (packages/platform-secrets/test/env-filter.test.ts):
# ws-check-ignore: XEON_HOME XEON_CLI_STATE_FILE XEON_SCENARIO_TAPE XEON_SCENARIO_COMMAND EXA_API_KEY XEON_MAX_TOOLS ProgramFiles WSL_DISTRO_NAME XEON_TEST_SECRET_VALUE KEEP_ME
# 모델 테이프 녹화기(packages/core-models/scripts/record-tape.ts)가 읽는 키. 값은 user 범위 저장소: secrets run user -- just tape-record …
ANTHROPIC_API_KEY=
