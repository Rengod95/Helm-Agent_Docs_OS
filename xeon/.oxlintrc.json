{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": { "es2024": true },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "vendor/**"
  ],
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-param-reassign": "error",
    "no-throw-literal": "error",
    "no-shadow": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true }
    ],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/require-await": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-base-to-string": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-deprecated": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-default-export": "error",
    "import/no-absolute-path": "error",
    "import/no-mutable-exports": "error",
    "import/first": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "unicorn/no-null": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-thenable": "error",
    "node/no-process-env": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@xeon/*/src", "@xeon/*/src/*", "@xeon/*/dist", "@xeon/*/dist/*"],
            "message": "Import a package only through its public exports, never its src or dist."
          },
          {
            "group": ["**/../packages/*", "../../../*", "../../*/src", "../../*/src/*"],
            "message": "Do not reach into another package by relative path; declare a workspace dependency and import @xeon/<name>."
          },
          { "group": ["vitest", "vitest/*", "jest", "@jest/*"], "message": "Tests use bun:test." },
          {
            "group": ["better-sqlite3", "node:sqlite", "sqlite3"],
            "message": "SQLite access goes through bun:sqlite inside platform-store."
          },
          {
            "group": ["cordis", "cordis/*", "@xeon/vendor-cordis", "@xeon/vendor-cordis/*"],
            "message": "Cordis is reachable only from packages/ext-host."
          },
          {
            "group": ["@sinclair/typebox", "@sinclair/typebox/*"],
            "message": "Use typebox 1.x (package 'typebox')."
          },
          { "group": ["lodash", "lodash/*", "moment"], "message": "Banned dependency." }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/ext-host/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["scripts/**", "apps/cli/**", "apps/host/**"],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "scripts/**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/require-await": "off",
        "no-shadow": "off"
      }
    }
  ]
}
