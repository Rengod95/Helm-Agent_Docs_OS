{
  "schemaVersion": 2,
  "name": "viewdemo",
  "version": "1.0.0",
  "entry": "./src/index.js",
  "plugins": [{ "layer": "plugin", "hooks": ["boundary.settle.after"] }],
  "ui": {
    "schemaVersion": 1,
    "widgets": "^1.0.0",
    "items": [
      {
        "id": "frame",
        "placement": "page",
        "mode": "app",
        "title": "Frame demo",
        "app": {
          "root": "./ui/app",
          "entry": "index.html",
          "bridge": "^1.0.0",
          "reason": "Shows how a Plugin App frame signals ready and answers ping."
        },
        "fallback": "./ui/native/frame-fallback.json"
      },
      {
        "id": "notes",
        "placement": "page",
        "mode": "native",
        "title": "Native demo",
        "file": "./ui/native/notes.json"
      }
    ]
  },
  "purpose": "프레임 화면과 기본 부품 화면을 하나씩 보여 준다",
  "description": "앱 화면 두 가지(자체 코드 프레임과 기본 부품)를 보여 주는 본보기"
}
