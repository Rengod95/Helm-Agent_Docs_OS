    "l1.models.providers": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "apiKeyRef": {
            "anyOf": [
              {
                "maxLength": 75,
                "pattern": "^secret://[a-z][a-z0-9-]{1,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseUrl": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
