          "enabled": {
            "type": "boolean"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "enabled",
          "apiKeyRef",
          "baseUrl"
        ],
        "type": "object"
