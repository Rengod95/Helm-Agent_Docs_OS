{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "l1.loop.maxSteps": {
      "default": 0,
      "maximum": 10000,
      "minimum": 0,
      "type": "integer",
      "x-xeon": {
        "allowedScopes": [
          "managed",
          "user",
          "project",
          "local",
          "session"
        ],
        "layer": "L1",
        "runtimeChange": "nextTurn",
        "secret": false,
        "since": "0.1.0",
        "ui": {
          "help": "0이면 상한 없음",
          "label": "turn당 최대 단계",
          "order": 10,
          "tab": "budgets",
          "unit": "단계",
          "widget": "number"
        }
      }
    },
    "l1.models.default": {
      "anyOf": [
        {
          "maxLength": 265,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/\\S{1,200}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "x-xeon": {
        "allowedScopes": [
          "managed",
          "user",
          "project",
          "local",
          "session"
        ],
        "layer": "L1",
        "runtimeChange": "nextTurn",
        "secret": false,
        "since": "0.1.0",
        "ui": {
          "help": "provider/modelId[:추론레벨] 형식",
          "label": "기본 모델",
          "order": 10,
          "tab": "models",
          "widget": "text"
        }
      }
    },
    "l1.models.providers": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "apiKeyRef": {
            "anyOf": [
              {
                "maxLength": 75,
                "pattern": "^secret://[a-z][a-z0-9-]{1,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseUrl": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "enabled",
          "apiKeyRef",
          "baseUrl"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array",
      "x-xeon": {
        "allowedScopes": [
          "managed",
          "user",
          "project",
          "local"
        ],
        "layer": "L1",
        "runtimeChange": "live",
        "secret": false,
        "since": "0.1.0",
        "ui": {
          "help": "키는 secret:// 참조만 저장한다",
          "label": "provider",
          "order": 10,
          "tab": "providers",
          "widget": "table"
        }
      }
    },
