    "l1.tools.rules": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "tool.call",
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "effect": {
            "anyOf": [
              {
                "const": "allow",
                "type": "string"
              },
              {
                "const": "ask",
                "type": "string"
              },
              {
                "const": "deny",
                "type": "string"
              }
            ]
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "priority": {
            "maximum": 999,
            "minimum": 0,
            "type": "integer"
          },
          "resource": {
            "additionalProperties": false,
            "properties": {
              "args": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "pattern": {
                      "maxLength": 1024,
                      "type": "string"
                    },
                    "pointer": {
                      "maxLength": 256,
                      "pattern": "^(?:|/.*)$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "pointer",
                    "pattern"
                  ],
                  "type": "object"
                },
                "maxItems": 16,
                "type": "array"
              },
              "caller": {
                "maxLength": 64,
                "pattern": "^(main|subagent|subagent:[a-z][a-z0-9-]{1,47})$",
                "type": "string"
              },
              "capability": {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              "classes": {
                "items": {
                  "anyOf": [
                    {
                      "const": "spawn",
                      "type": "string"
                    },
                    {
                      "const": "user_interaction",
                      "type": "string"
                    },
                    {
                      "const": "shared_state_write",
                      "type": "string"
                    },
                    {
                      "const": "external_send",
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 4,
                "type": "array"
              },
              "mcpServer": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "minDepth": {
                "minimum": 0,
                "type": "integer"
              },
              "mode": {
                "items": {
                  "anyOf": [
                    {
                      "const": "default",
                      "type": "string"
                    },
                    {
                      "const": "acceptEdits",
                      "type": "string"
                    },
                    {
                      "const": "plan",
                      "type": "string"
                    },
                    {
                      "const": "bypass",
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 4,
                "type": "array"
              },
              "risk": {
                "items": {
                  "anyOf": [
                    {
                      "const": "read",
                      "type": "string"
                    },
                    {
                      "const": "write",
                      "type": "string"
                    },
                    {
                      "const": "exec",
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 3,
                "type": "array"
              },
              "tool": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "action",
          "resource",
          "effect"
        ],
        "type": "object"
      },
      "maxItems": 512,
      "type": "array",
      "x-xeon": {
        "allowedScopes": [
          "managed",
          "user",
          "project",
          "local",
          "session"
