{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fresnel",
  "version": "0.0.0",
  "identifier": "dev.fresnel.desktop",
  "build": { "frontendDist": "./ui" },
  "app": {
    "windows": [{ "label": "main", "title": "Fresnel", "width": 1100, "height": 760 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-src fresnel-view:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/fresnel"]
  }
}
