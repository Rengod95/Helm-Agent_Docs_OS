{
  "name": "@fresnel/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json src test",
    "typecheck": "tsc -b",
    "test": "bash ../../scripts/test-pkg.sh",
    "fmt-check": "oxfmt --check -c ../../.oxfmtrc.json src test",
    "spike:engine": "bun build --compile spike/tests/engine.ts --outfile spike/out/engine",
    "spike:s2": "bash spike/s2-size.sh",
    "spike:s4": "bun spike/tests/s4.ts spike/out 20",
    "spike:stub": "bun spike/tests/parent-stub.ts",
    "spike:engine-dev": "bun spike/tests/engine.ts",
    "build:ui": "vite build",
    "build:ui:dev": "vite build --mode dev",
    "mockup": "vite --config mockups/vite.config.ts",
    "mockup:build": "vite build --config mockups/vite.config.ts"
  },
  "dependencies": {
    "@caustic/react": "workspace:*",
    "@caustic/tokens": "workspace:*",
    "@fresnel/client": "workspace:*",
    "@fresnel/contracts": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:"
  },
  "fresnel": {
    "layer": "L4",
    "domain": "desktop"
  }
}
