{
  "name": "@xeon/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json src test",
    "typecheck": "tsc -b",
    "test": "bun test",
    "fmt-check": "oxfmt --check -c ../../.oxfmtrc.json src test",
    "spike:engine": "bun build --compile spike/tests/engine.ts --outfile spike/out/engine",
    "spike:s2": "bash spike/s2-size.sh",
    "spike:s4": "bun spike/tests/s4.ts spike/out 20",
    "spike:stub": "bun spike/tests/parent-stub.ts",
    "spike:engine-dev": "bun spike/tests/engine.ts",
    "build:ui": "bun build index.html --outdir src-tauri/ui --minify --define __XEON_CHECKS__=false",
    "build:ui:dev": "bun build index.html --outdir src-tauri/ui --define __XEON_CHECKS__=true"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:",
    "@xeon/client": "workspace:*",
    "@xeon/contracts": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typebox": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "xeon": {
    "layer": "L4",
    "domain": "desktop"
  }
}
