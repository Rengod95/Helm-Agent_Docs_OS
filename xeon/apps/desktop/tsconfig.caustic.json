{
  "extends": "../../external/caustic/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "../../external/caustic/packages/react/src",
    "outDir": "dist/caustic-react",
    "tsBuildInfoFile": "dist/caustic-react/.tsbuildinfo",
    "types": ["bun"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["../../external/caustic/packages/react/src/**/*"]
}
