{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false,
    "reportUnusedDisableDirectives": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "vendor/**",
    "packages/group-kit/templates/**",
    "apps/desktop/mockups/**"
  ]
}
