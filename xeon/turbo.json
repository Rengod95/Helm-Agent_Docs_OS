{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "tasks": {
    "lint": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/.oxlintrc.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!**/*.test.ts"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test-pkg.sh",
        "$TURBO_ROOT$/scripts/test-preload.ts",
        "$TURBO_ROOT$/scripts/ensure-sidecar.sh",
        "$TURBO_ROOT$/../scripts/guard.sh"
      ],
      "outputs": []
    },
    "fmt-check": {
      "inputs": ["src/**", "test/**", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputs": []
    }
  }
}
