{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "ignoreWorkspaces": ["external/caustic/packages/tokens", "external/caustic/packages/react"],
  "ignore": ["external/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": ["@swc/core"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/group-kit": {
      "entry": ["test/**/*.test.ts"],
      "ignore": ["templates/**"]
    },
    "plugins/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "apps/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/platform-exec": {
      "entry": ["test/**/*.test.ts"],
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/cap-workspace": {
      "entry": ["test/**/*.test.ts", "test/support/atomic-victim.ts"]
    },
    "packages/core-persistence": {
      "entry": ["test/**/*.test.ts", "test/support/crash-child.ts"]
    },
    "packages/platform-process": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts"]
    },
    "apps/desktop": {
      "entry": ["test/**/*.test.{ts,tsx}", "src/main.tsx"],
      "ignoreDependencies": ["@caustic/react", "@caustic/tokens"]
    },
    "apps/host": {
      "entry": [
        "test/**/*.test.ts",
        "test/fixtures/crash-host.ts",
        "test/fixtures/helm-crash-host.ts",
        "test/fixtures/mcp-stdio-server.ts",
        "test/fixtures/mcp-sandbox-probe.ts",
        "test/fixtures/marker-child.ts",
        "test/fixtures/secret-add-child.ts"
      ]
    },
    "apps/cli": {
      "entry": [
        "test/**/*.test.ts",
        "test/fixtures/scenario-main.ts",
        "test/fixtures/scenario-host.ts"
      ]
    }
  },
  "ignoreIssues": {
    "package.json": ["catalog"]
  }
}
