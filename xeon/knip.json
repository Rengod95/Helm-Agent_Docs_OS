{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": ["@swc/core"]
    },
    "packages/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "plugins/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "apps/*": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/platform-exec": {
      "entry": ["test/**/*.test.ts"],
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/core-persistence": {
      "entry": ["test/**/*.test.ts", "test/support/crash-child.ts"]
    },
    "packages/platform-process": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts"]
    },
    "apps/cli": {
      "entry": ["test/**/*.test.ts", "test/fixtures/scenario-main.ts"]
    }
  }
}
