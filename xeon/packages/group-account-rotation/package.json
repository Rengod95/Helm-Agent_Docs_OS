{
  "name": "@fresnel/group-account-rotation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./scripts/build-plugin.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json src test scripts",
    "typecheck": "tsc -b",
    "test": "bash ../../scripts/test-pkg.sh",
    "fmt-check": "oxfmt --check -c ../../.oxfmtrc.json src test scripts",
    "build:plugin": "bun scripts/build-plugin.ts"
  },
  "dependencies": {
    "@fresnel/contracts": "workspace:*",
    "@fresnel/group-sdk": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@fresnel/ext-host": "workspace:*",
    "@types/bun": "catalog:"
  },
  "fresnel": {
    "layer": "L3",
    "domain": "account-rotation"
  }
}
