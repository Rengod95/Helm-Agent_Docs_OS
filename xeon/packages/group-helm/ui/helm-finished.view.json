{
  "type": "Stack",
  "children": [
    {
      "type": "Heading",
      "bind": {
        "text": {
          "path": "/topic"
        }
      }
    },
    {
      "type": "Row",
      "children": [
        {
          "type": "Badge",
          "props": {
            "text": "helm.outcome.applied"
          },
          "when": {
            "path": "/outcome",
            "op": "eq",
            "value": "applied"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.outcome.empty"
          },
          "when": {
            "path": "/outcome",
            "op": "eq",
            "value": "empty"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.outcome.stopped"
          },
          "when": {
            "path": "/outcome",
            "op": "eq",
            "value": "stopped"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.outcome.limit"
          },
          "when": {
            "path": "/outcome",
            "op": "eq",
            "value": "limit"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.outcome.failed"
          },
          "when": {
            "path": "/outcome",
            "op": "eq",
            "value": "failed"
          }
        },
        {
          "type": "Text",
          "props": {
            "text": "helm.findings"
          }
        },
        {
          "type": "Text",
          "bind": {
            "text": {
              "path": "/findingCount",
              "format": "number"
            }
          }
        }
      ]
    },
    {
      "type": "Text",
      "bind": {
        "text": {
          "path": "/reason"
        }
      },
      "when": {
        "path": "/reason",
        "op": "exists"
      }
    }
  ]
}
