{
  "type": "Stack",
  "when": { "path": "/action", "op": "eq", "value": "suggested" },
  "children": [
    { "type": "Text", "props": { "text": "helm.signal.detected" } },
    {
      "type": "Row",
      "children": [
        { "type": "Text", "props": { "text": "helm.signal.label" } },
        { "type": "Badge", "bind": { "text": { "path": "/signal" } } },
        {
          "type": "Text",
          "bind": { "text": { "path": "/evidence/toolName" } },
          "when": { "path": "/evidence/toolName", "op": "exists" }
        }
      ]
    },
    { "type": "Button", "props": { "label": "helm.start.submit", "command": "helm start" } }
  ]
}
