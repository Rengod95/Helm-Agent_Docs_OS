{
  "type": "Stack",
  "children": [
    {
      "type": "Section",
      "props": {
        "title": "helm.current.title"
      },
      "children": [
        {
          "type": "Stepper",
          "bind": {
            "current": {
              "path": "/status/phase"
            }
          },
          "children": [
            {
              "type": "Text",
              "props": {
                "step": "idle",
                "text": "helm.phase.idle"
              }
            },
            {
              "type": "Text",
              "props": {
                "step": "diverge",
                "text": "helm.phase.diverge"
              }
            },
            {
              "type": "Text",
              "props": {
                "step": "explore",
                "text": "helm.phase.explore"
              }
            },
            {
              "type": "Text",
              "props": {
                "step": "converge",
                "text": "helm.phase.converge"
              }
            },
            {
              "type": "Text",
              "props": {
                "step": "apply",
                "text": "helm.phase.apply"
              }
            }
          ]
        },
        {
          "type": "Row",
          "when": {
            "path": "/status/inquiryId",
            "op": "ne",
            "value": null
          },
          "children": [
            {
              "type": "Badge",
              "props": {
                "text": "helm.lease.held"
              },
              "when": {
                "path": "/status/lease",
                "op": "eq",
                "value": "held"
              }
            },
            {
              "type": "Badge",
              "props": {
                "text": "helm.lease.waiting"
              },
              "when": {
                "path": "/status/lease",
                "op": "eq",
                "value": "waiting"
              }
            },
            {
              "type": "Badge",
              "props": {
                "text": "helm.lease.none"
              },
              "when": {
                "path": "/status/lease",
                "op": "eq",
                "value": "none"
              }
            },
            {
              "type": "Meter",
              "props": {
                "label": "helm.findings.count",
                "max": 24
              },
              "bind": {
                "value": {
                  "path": "/status/findings"
                }
              }
            }
          ]
        },
        {
          "type": "ActivityTree",
          "children": [
            {
              "type": "Row",
              "each": {
                "path": "/status/lenses",
                "as": "lens"
              },
              "children": [
                {
                  "type": "Text",
                  "bind": {
                    "text": {
                      "path": "/lens/title"
                    }
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.lens.pending"
                  },
                  "when": {
                    "path": "/lens/status",
                    "op": "eq",
                    "value": "pending"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.lens.running"
                  },
                  "when": {
                    "path": "/lens/status",
                    "op": "eq",
                    "value": "running"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.lens.done"
                  },
                  "when": {
                    "path": "/lens/status",
                    "op": "eq",
                    "value": "done"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.lens.failed"
                  },
                  "when": {
                    "path": "/lens/status",
                    "op": "eq",
                    "value": "failed"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.lens.skipped"
                  },
                  "when": {
                    "path": "/lens/status",
                    "op": "eq",
                    "value": "skipped"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "EmptyState",
          "props": {
            "text": "helm.empty.noInquiry"
          },
          "when": {
            "path": "/status/inquiryId",
            "op": "eq",
            "value": null
          }
        }
      ]
    },
    {
      "type": "Section",
      "props": {
        "title": "helm.findings"
      },
      "when": {
        "path": "/status/inquiryId",
        "op": "ne",
        "value": null
      },
      "children": [
        {
          "type": "List",
          "children": [
            {
              "type": "Row",
              "each": {
                "path": "/findings/findings",
                "as": "finding"
              },
              "children": [
                {
                  "type": "Text",
                  "bind": {
                    "text": {
                      "path": "/finding/claim"
                    }
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.severity.high"
                  },
                  "when": {
                    "path": "/finding/confidence",
                    "op": "eq",
                    "value": "high"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.severity.medium"
                  },
                  "when": {
                    "path": "/finding/confidence",
                    "op": "eq",
                    "value": "medium"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.severity.low"
                  },
                  "when": {
                    "path": "/finding/confidence",
                    "op": "eq",
                    "value": "low"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Section",
      "props": {
        "title": "helm.past.title"
      },
      "children": [
        {
          "type": "List",
          "children": [
            {
              "type": "Row",
              "each": {
                "path": "/inquiries/inquiries",
                "as": "inquiry"
              },
              "children": [
                {
                  "type": "Text",
                  "bind": {
                    "text": {
                      "path": "/inquiry/topic"
                    }
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.inquiry.queued"
                  },
                  "when": {
                    "path": "/inquiry/status",
                    "op": "eq",
                    "value": "pending"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.inquiry.running"
                  },
                  "when": {
                    "path": "/inquiry/status",
                    "op": "eq",
                    "value": "running"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.inquiry.done"
                  },
                  "when": {
                    "path": "/inquiry/status",
                    "op": "eq",
                    "value": "finished"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.outcome.applied"
                  },
                  "when": {
                    "path": "/inquiry/outcome",
                    "op": "eq",
                    "value": "applied"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.outcome.empty"
                  },
                  "when": {
                    "path": "/inquiry/outcome",
                    "op": "eq",
                    "value": "empty"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.outcome.stopped"
                  },
                  "when": {
                    "path": "/inquiry/outcome",
                    "op": "eq",
                    "value": "stopped"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.outcome.limit"
                  },
                  "when": {
                    "path": "/inquiry/outcome",
                    "op": "eq",
                    "value": "limit"
                  }
                },
                {
                  "type": "Badge",
                  "props": {
                    "text": "helm.outcome.failed"
                  },
                  "when": {
                    "path": "/inquiry/outcome",
                    "op": "eq",
                    "value": "failed"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Form",
      "props": {
        "command": "helm start",
        "submitLabel": "helm.start.submit"
      },
      "when": {
        "path": "/status/lease",
        "op": "eq",
        "value": "none"
      },
      "children": [
        {
          "type": "TextField",
          "props": {
            "name": "arg",
            "label": "helm.topic.label",
            "placeholder": "helm.topic.placeholder",
            "maxLength": 300
          }
        }
      ]
    },
    {
      "type": "Button",
      "props": {
        "label": "helm.stop.label",
        "command": "helm stop"
      },
      "when": {
        "path": "/status/lease",
        "op": "ne",
        "value": "none"
      }
    }
  ]
}
