{
  "type": "Stack",
  "children": [
    {
      "type": "Chip",
      "props": { "text": "helm.phase.idle" },
      "when": { "path": "/status/phase", "op": "eq", "value": "idle" }
    },
    {
      "type": "Chip",
      "props": { "text": "helm.phase.diverge" },
      "when": { "path": "/status/phase", "op": "eq", "value": "diverge" }
    },
    {
      "type": "Chip",
      "props": { "text": "helm.phase.explore" },
      "when": { "path": "/status/phase", "op": "eq", "value": "explore" }
    },
    {
      "type": "Chip",
      "props": { "text": "helm.phase.converge" },
      "when": { "path": "/status/phase", "op": "eq", "value": "converge" }
    },
    {
      "type": "Chip",
      "props": { "text": "helm.phase.apply" },
      "when": { "path": "/status/phase", "op": "eq", "value": "apply" }
    }
  ]
}
