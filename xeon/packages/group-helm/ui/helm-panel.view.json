{
  "type": "Stack",
  "children": [
    {
      "type": "Stepper",
      "bind": {
        "current": {
          "path": "/status/phase"
        }
      },
      "children": [
        {
          "type": "Text",
          "props": {
            "step": "idle",
            "text": "helm.phase.idle"
          }
        },
        {
          "type": "Text",
          "props": {
            "step": "diverge",
            "text": "helm.phase.diverge"
          }
        },
        {
          "type": "Text",
          "props": {
            "step": "explore",
            "text": "helm.phase.explore"
          }
        },
        {
          "type": "Text",
          "props": {
            "step": "converge",
            "text": "helm.phase.converge"
          }
        },
        {
          "type": "Text",
          "props": {
            "step": "apply",
            "text": "helm.phase.apply"
          }
        }
      ]
    },
    {
      "type": "Text",
      "bind": {
        "text": {
          "path": "/status/topic"
        }
      },
      "when": {
        "path": "/status/inquiryId",
        "op": "ne",
        "value": null
      }
    },
    {
      "type": "Row",
      "children": [
        {
          "type": "Text",
          "props": {
            "text": "helm.findings"
          }
        },
        {
          "type": "Text",
          "bind": {
            "text": {
              "path": "/status/findings",
              "format": "number"
            }
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.lease.held"
          },
          "when": {
            "path": "/status/lease",
            "op": "eq",
            "value": "held"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.lease.waiting"
          },
          "when": {
            "path": "/status/lease",
            "op": "eq",
            "value": "waiting"
          }
        },
        {
          "type": "Badge",
          "props": {
            "text": "helm.lease.none"
          },
          "when": {
            "path": "/status/lease",
            "op": "eq",
            "value": "none"
          }
        }
      ]
    },
    {
      "type": "Form",
      "props": {
        "command": "helm start",
        "submitLabel": "helm.start.submit"
      },
      "when": {
        "path": "/status/lease",
        "op": "eq",
        "value": "none"
      },
      "children": [
        {
          "type": "TextField",
          "props": {
            "name": "arg",
            "label": "helm.topic.label",
            "placeholder": "helm.topic.placeholder",
            "maxLength": 300
          }
        }
      ]
    },
    {
      "type": "Button",
      "props": {
        "label": "helm.stop.label",
        "command": "helm stop"
      },
      "when": {
        "path": "/status/lease",
        "op": "ne",
        "value": "none"
      }
    }
  ]
}
