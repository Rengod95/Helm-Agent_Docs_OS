{
  "name": "@fresnel/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./stdio": "./src/stdio.ts",
    "./endpoint": "./src/endpoint.ts",
    "./socket": "./src/socket.ts",
    "./settings": "./src/settings/index.ts",
    "./accounts": "./src/accounts/index.ts",
    "./web": "./src/web/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./views/native": "./src/views/native/index.ts",
    "./views/app": "./src/views/app/index.ts",
    "./views/ledger": "./src/views/ledger.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json src test",
    "typecheck": "tsc -b",
    "test": "bash ../../scripts/test-pkg.sh",
    "fmt-check": "oxfmt --check -c ../../.oxfmtrc.json src test"
  },
  "dependencies": {
    "@fresnel/contracts": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@fresnel/core-models": "workspace:*",
    "@types/bun": "catalog:"
  },
  "fresnel": {
    "layer": "L4",
    "domain": "client"
  }
}
