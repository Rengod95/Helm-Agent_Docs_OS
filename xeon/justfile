# Xeon 실제 명령. 루트 justfile이 `cd xeon && just <레시피>`로 부른다. 레시피는 10줄 이하, 길면 scripts/*.sh.
set shell := ["bash", "-euo", "pipefail", "-c"]

bun := "mise exec -- bun"

export TURBO_TELEMETRY_DISABLED := "1"

# 잠금 파일 기준으로 의존성 설치
[group('setup')]
setup:
    {{bun}} install --frozen-lockfile

# 포매팅 적용
[group('quality')]
fmt:
    {{bun}} run fmt

# 포매팅 검사: scripts와 설정 파일, 각 패키지
[group('quality')]
fmt-check:
    {{bun}} run fmt-check:root
    {{bun}} run fmt-check

# 정적 검사: scripts, 각 패키지 (type-aware)
[group('quality')]
lint:
    {{bun}} run lint:root
    {{bun}} run lint

# 타입 검사: scripts, 각 패키지 (tsc -b)
[group('quality')]
typecheck:
    {{bun}} run typecheck:root
    {{bun}} run typecheck

# 단위 테스트: scripts, 각 패키지를 하나씩 메모리 상한 아래에서 (scripts/test-capped.sh)
[group('quality')]
test *targets:
    scripts/test-capped.sh {{targets}}

# 층 순위 검사
[group('local')]
check-layers:
    {{bun}} run check-layers

# TypeScript 작성 규칙 스캔 (scripts/check-ts-rules.ts)
[group('local')]
check-ts-rules:
    {{bun}} run check-ts-rules

# 의존 경계 검사
[group('local')]
depcruise:
    {{bun}} run depcruise

# 미사용 코드 검사
[group('local')]
knip:
    {{bun}} run knip

# 문서 라우팅·검사: --check | --task <작업> <경로...>
[group('local')]
docs-route +args:
    {{bun}} scripts/docs-route.ts {{args}}

# 한 층만 lint, typecheck, test (scripts/ci-layer.sh)
[group('local')]
ci-layer layer affected="false":
    bash scripts/ci-layer.sh {{layer}} {{affected}}

# 웹 가격표 asOf 90일 검사: 오래된 항목을 출력만 하고 종료코드는 0 (L2.web.plan B5)
[group('local')]
web-pricing:
    cd packages/cap-web && {{bun}} run web-pricing

# 데스크톱 사이드카 빌드 <triple> (자리: m2-plan DESK.3 구현 전까지 종료코드 2: 미구현 자리라 코드를 고치는 문제가 아님)
[group('local')]
desktop-sidecar triple:
    @echo "desktop-sidecar {{triple}}: 아직 구현되지 않았습니다 (m2-plan DESK.3, L4.desktop.plan D3)" >&2; exit 2

# 데스크톱 개발 실행 (자리: m2-plan DESK.2 구현 전까지 종료코드 2: 미구현 자리라 코드를 고치는 문제가 아님)
[group('local')]
desktop-run:
    @echo "desktop-run: 아직 구현되지 않았습니다 (m2-plan DESK.2, L4.desktop.plan D2)" >&2; exit 2

# 데스크톱 앱 빌드 (자리: m2-plan DESK.2 구현 전까지 종료코드 2: 미구현 자리라 코드를 고치는 문제가 아님)
[group('local')]
desktop-build:
    @echo "desktop-build: 아직 구현되지 않았습니다 (m2-plan DESK.2, L4.desktop.plan D2)" >&2; exit 2
