# Xeon 실제 명령. 루트 justfile이 `cd xeon && just <레시피>`로 부른다. 레시피는 10줄 이하, 길면 scripts/*.sh.
set shell := ["bash", "-euo", "pipefail", "-c"]

bun := "mise exec -- bun"

export TURBO_TELEMETRY_DISABLED := "1"

# 잠금 파일 기준으로 의존성 설치
[group('setup')]
setup:
    {{bun}} install --frozen-lockfile

# 포매팅 적용
[group('quality')]
fmt:
    {{bun}} run fmt

# 포매팅 검사: scripts와 설정 파일, 각 패키지
[group('quality')]
fmt-check:
    {{bun}} run fmt-check:root
    {{bun}} run fmt-check

# 정적 검사: scripts, 각 패키지 (type-aware)
[group('quality')]
lint:
    {{bun}} run lint:root
    {{bun}} run lint

# 타입 검사: scripts, 각 패키지 (tsc -b)
[group('quality')]
typecheck:
    {{bun}} run typecheck:root
    {{bun}} run typecheck

# 단위 테스트: scripts, 각 패키지를 하나씩 메모리 상한 아래에서 (scripts/test-capped.sh)
[group('quality')]
test *targets:
    scripts/test-capped.sh {{targets}}

# 층 순위 검사
[group('local')]
check-layers:
    {{bun}} run check-layers

# TypeScript 작성 규칙 스캔 (scripts/check-ts-rules.ts)
[group('local')]
check-ts-rules:
    {{bun}} run check-ts-rules

# 의존 경계 검사
[group('local')]
depcruise:
    {{bun}} run depcruise

# 미사용 코드 검사
[group('local')]
knip:
    {{bun}} run knip

# 문서 라우팅·검사: --check | --task <작업> <경로...> | --unresolved([미결 표지 수)
[group('local')]
docs-route +args:
    {{bun}} scripts/docs-route.ts {{args}}

# 한 층만 lint, typecheck, test (scripts/ci-layer.sh)
[group('local')]
ci-layer layer affected="false":
    bash scripts/ci-layer.sh {{layer}} {{affected}}

# 웹 가격표 asOf 90일 검사: 오래된 항목을 출력만 하고 종료코드는 0 (L2.web.plan B5)
[group('local')]
web-pricing:
    cd packages/cap-web && {{bun}} run web-pricing

# 데스크톱 사이드카 빌드 <triple|host>: bun build --compile --minify --bytecode, 크기 상한 검사 (scripts/build-sidecar.ts). --no-bytecode, --list는 `just desktop-sidecar host --no-bytecode`처럼 붙인다
[group('local')]
desktop-sidecar triple *flags:
    {{bun}} scripts/build-sidecar.ts {{triple}} {{flags}}

# 데스크톱 화면 번들 (bun build → apps/desktop/src-tauri/ui). 인자 dev는 불변식 검사를 켠 개발 빌드. just verify 밖
[group('local')]
desktop-ui mode="release":
    {{bun}} run --cwd apps/desktop {{ if mode == "dev" { "build:ui:dev" } else { "build:ui" } }}

# 데스크톱 개발 실행 (cargo run, 사이드카 필요: 없으면 종료코드 2). just verify 밖
[group('local')]
desktop-run:
    bash apps/desktop/scripts/cargo.sh run

# 데스크톱 앱 릴리스 빌드 (cargo build --release, 사이드카 필요: 없으면 종료코드 2). 설치 파일 번들은 D10. just verify 밖
[group('local')]
desktop-build:
    bash apps/desktop/scripts/cargo.sh build

# 데스크톱 Rust 셸 단위 시험 (cargo test: 릴레이, 엔진 수명). 사이드카 불필요, cargo 없으면 종료코드 2. just verify 밖
[group('local')]
desktop-test:
    bash apps/desktop/scripts/cargo.sh test
