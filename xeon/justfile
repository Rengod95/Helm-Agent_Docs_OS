# Xeon 실제 명령. 루트 justfile이 `cd xeon && just <레시피>`로 부른다. 레시피는 10줄 이하, 길면 scripts/*.sh.
set shell := ["bash", "-euo", "pipefail", "-c"]

bun := "mise exec -- bun"

export TURBO_TELEMETRY_DISABLED := "1"
# turbo 캐시는 모든 worktree가 함께 쓴다: 에이전트 worktree의 결과를 메인 체크아웃이 다시 쓴다 (scripts/test-capped.sh도 같은 기본값)
export TURBO_CACHE_DIR := env("TURBO_CACHE_DIR", env("HOME") + "/.cache/xeon/turbo")

# 잠금 파일 기준으로 의존성 설치
[group('setup')]
setup:
    {{bun}} install --frozen-lockfile

# 포매팅 적용
[group('quality')]
fmt:
    {{bun}} run fmt

# 포매팅 검사: scripts와 설정 파일, 각 패키지
[group('quality')]
fmt-check:
    {{bun}} run fmt-check:root
    {{bun}} run fmt-check

# 정적 검사: mode=full은 type-aware(scripts와 각 패키지, turbo 캐시), mode=fast는 type-aware 없이 한 번에(.oxlintrc.fast.json, 1초 안쪽)
[group('quality')]
lint mode="full":
    {{ if mode == "fast" { bun + " run lint:fast" } else { bun + " run lint:root && " + bun + " run lint" } }}

# 타입 검사: scripts, 각 패키지 (tsc -b)
[group('quality')]
typecheck:
    {{bun}} run typecheck:root
    {{bun}} run typecheck

# 단위 테스트: scripts는 매번, 패키지는 turbo 캐시에 맞으면 재생하고 아니면 메모리 상한 아래에서 (scripts/test-capped.sh)
[group('quality')]
test *targets:
    scripts/test-capped.sh {{targets}}

# 층 순위 검사
[group('local')]
check-layers:
    {{bun}} run check-layers

# TypeScript 작성 규칙 스캔 (scripts/check-ts-rules.ts)
[group('local')]
check-ts-rules:
    {{bun}} run check-ts-rules

# 의존 경계 검사
[group('local')]
depcruise:
    {{bun}} run depcruise

# 미사용 코드 검사
[group('local')]
knip:
    {{bun}} run knip

# 문서 라우팅·검사: --check | --task <작업> <경로...> | --unresolved([미결 표지 수)
[group('local')]
docs-route +args:
    {{bun}} scripts/docs-route.ts {{args}}

# 요구 장부 검사: M3-REQ 행마다 상태(M3a, M3b:<트랙 id>, M4), 이월 표마다 트랙 id, 상태별 개수 (scripts/req-ledger.ts)
[group('local')]
req-ledger:
    {{bun}} scripts/req-ledger.ts

# 패키지 하나만 lint, typecheck, test: 각각 scripts/guard.sh run 1.5G 아래에서 차례로. 병렬 작업 중 에이전트는 이것만 돌린다 (scripts/check-pkg.sh)
[group('quality')]
check pkg:
    bash scripts/check-pkg.sh {{pkg}}

# 한 층만 lint, typecheck, test (scripts/ci-layer.sh). root는 scripts의 lint, typecheck, test
[group('local')]
ci-layer layer affected="false":
    bash scripts/ci-layer.sh {{layer}} {{affected}}

# 종료 조건 시험(scripts/exit-tests.txt)을 돌리고 건너뛴 수를 출력한다. 파일 없음, 건너뜀, 실패는 종료코드 1. apps/desktop 줄(E2·E3)이 있으면 사이드카가 없을 때 `desktop-sidecar host`를 먼저 단독으로 돌린다
[group('local')]
exit-tests:
    {{bun}} scripts/exit-tests.ts

# 웹 가격표 asOf 90일 검사: 오래된 항목을 출력만 하고 종료코드는 0 (L2.web.plan B5)
[group('local')]
web-pricing:
    cd packages/cap-web && {{bun}} run web-pricing

# 데스크톱 사이드카 빌드 <triple|host>: bun build --compile --minify --bytecode, 크기 상한 검사 (scripts/build-sidecar.ts). --no-bytecode, --list는 `just desktop-sidecar host --no-bytecode`처럼 붙인다
[group('local')]
desktop-sidecar triple *flags:
    {{bun}} scripts/build-sidecar.ts {{triple}} {{flags}}

# 데스크톱 화면 번들 (bun build → apps/desktop/src-tauri/ui). 인자 dev는 불변식 검사를 켠 개발 빌드. just verify 밖
[group('local')]
desktop-ui mode="release":
    {{bun}} run --cwd apps/desktop {{ if mode == "dev" { "build:ui:dev" } else { "build:ui" } }}

# 데스크톱 개발 실행 (cargo run, 사이드카 필요: 없으면 종료코드 2). just verify 밖
[group('local')]
desktop-run:
    bash apps/desktop/scripts/cargo.sh run

# 데스크톱 앱 릴리스 빌드 (cargo build --release, 사이드카 필요: 없으면 종료코드 2). 설치 파일 번들은 D10. just verify 밖
[group('local')]
desktop-build:
    bash apps/desktop/scripts/cargo.sh build

# 데스크톱 Rust 셸 단위 시험 (cargo test: 릴레이, 엔진 수명). 사이드카 불필요, cargo 없으면 종료코드 2. just verify 밖
[group('local')]
desktop-test:
    bash apps/desktop/scripts/cargo.sh test

# 실제 provider로 모델 테이프 녹화 <scenario>: 비용이 들어 --yes 없이는 계획만 보이고 종료코드 3 (scripts/tape-record.ts, D-e)
[group('local')]
tape-record scenario *flags:
    {{bun}} scripts/tape-record.ts {{scenario}} {{flags}}

# 속도 기준선: 콜드 스타트(CLI, 사이드카). --first-token은 실제 모델 호출이라 --yes 없이는 종료코드 3 (scripts/bench.ts, ADR-0012)
[group('local')]
bench *flags:
    {{bun}} scripts/bench.ts {{flags}}
