# Fresnel 실제 명령. 루트 justfile이 `cd xeon && just <레시피>`로 부른다. 레시피는 10줄 이하, 길면 scripts/*.sh.
set shell := ["bash", "-euo", "pipefail", "-c"]

bun := "mise exec -- bun"

# turbo가 한 번에 돌리는 패키지 수: macOS(10코어, 32G, 메모리 상한 없음)는 lint 4, typecheck 4, Linux는 package.json 값(1, 2). FRESNEL_TURBO_LINT·FRESNEL_TURBO_TYPECHECK로 바꾼다
turbo_lint := env("FRESNEL_TURBO_LINT", if os() == "macos" { "4" } else { "1" })
turbo_typecheck := env("FRESNEL_TURBO_TYPECHECK", if os() == "macos" { "4" } else { "2" })

export TURBO_TELEMETRY_DISABLED := "1"
# turbo 캐시는 모든 worktree가 함께 쓴다: 에이전트 worktree의 결과를 메인 체크아웃이 다시 쓴다 (scripts/test-capped.sh도 같은 기본값)
export TURBO_CACHE_DIR := env("TURBO_CACHE_DIR", env("HOME") + "/.cache/fresnel/turbo")

# 잠금 파일 기준으로 의존성 설치
[group('setup')]
setup:
    git submodule update --init external/caustic
    {{bun}} install --frozen-lockfile

# caustic(디자인 시스템, git submodule)을 main 최신으로 올리고 의존을 다시 설치한다. 커밋은 따로 한다
[group('setup')]
caustic-update:
    git submodule update --remote external/caustic
    {{bun}} install
    git -C external/caustic log --oneline -1

# 포매팅 적용
[group('quality')]
fmt:
    {{bun}} run fmt

# 포매팅 검사: scripts와 설정 파일, 각 패키지
[group('quality')]
fmt-check:
    {{bun}} run fmt-check:root
    {{bun}} run fmt-check

# 정적 검사: mode=full은 type-aware(scripts와 각 패키지, turbo 캐시), mode=fast는 type-aware 없이 한 번에(.oxlintrc.fast.json, 1초 안쪽)
[group('quality')]
lint mode="full":
    {{ if mode == "fast" { bun + " run lint:fast" } else { bun + " run lint:root && " + bun + " run turbo run lint --concurrency=" + turbo_lint } }}

# 타입 검사: scripts, 각 패키지 (tsc -b)
[group('quality')]
typecheck:
    {{bun}} run typecheck:root
    {{bun}} run turbo run typecheck --concurrency={{turbo_typecheck}}

# 단위 테스트: scripts는 매번, 패키지는 turbo 캐시에 맞으면 재생하고 아니면 메모리 상한 아래에서 (scripts/test-capped.sh)
[group('quality')]
test *targets:
    scripts/test-capped.sh {{targets}}

# 층 순위 검사
[group('local')]
check-layers:
    {{bun}} run check-layers

# TypeScript 작성 규칙 스캔 (scripts/check-ts-rules.ts)
[group('local')]
check-ts-rules:
    {{bun}} run check-ts-rules

# 의존 경계 검사
[group('local')]
depcruise:
    {{bun}} run depcruise

# 미사용 코드 검사
[group('local')]
knip:
    {{bun}} run knip

# 문서 라우팅·검사: --check | --task <작업> <경로...> | --unresolved([미결 표지 수)
[group('local')]
docs-route +args:
    {{bun}} scripts/docs-route.ts {{args}}

# 용어 검사 1~3단계: gen은 원본(packages/client/src/i18n/terms.json)에서 카탈로그 term.* 키를 만들고 표식 문장(locales/*.src.json)을 풀며(--mockups는 목업 파생물도), check는 T·C·M·S·D 규칙을 검사한다 (scripts/terms.ts)
[group('local')]
terms mode *flags:
    {{bun}} scripts/terms.ts {{mode}} {{flags}}

# 요구 장부 검사: M3-REQ 행마다 상태(M3a, M3b, M3b:<트랙 id>, M4, M4:<트랙 id>), 이월 표마다 트랙 id·M4·M5:<사유>·삭제:<사유>, 상태별 개수 (scripts/req-ledger.ts)
[group('local')]
req-ledger:
    {{bun}} scripts/req-ledger.ts

# caustic 부품 간극 표 검사: spec §9의 C 항목마다 상태 칸 (scripts/caustic-gaps.ts)
[group('local')]
caustic-gaps:
    {{bun}} scripts/caustic-gaps.ts

# 패키지 하나만 lint, typecheck, test: 각각 scripts/guard.sh run 1.5G 아래에서 차례로. 병렬 작업 중 에이전트는 이것만 돌린다 (scripts/check-pkg.sh)
[group('quality')]
check pkg:
    bash scripts/check-pkg.sh {{pkg}}

# 한 층만 lint, typecheck, test (scripts/ci-layer.sh). root는 scripts의 lint, typecheck, test
[group('local')]
ci-layer layer affected="false":
    bash scripts/ci-layer.sh {{layer}} {{affected}}

# 종료 조건 시험(scripts/exit-tests.txt)을 돌리고 건너뛴 수를 출력한다. 파일 없음, 건너뜀, 실패는 종료코드 1. apps/desktop 줄(E2·E3)이 있으면 사이드카가 없을 때 `desktop-sidecar host`를 먼저 단독으로 돌린다
[group('local')]
exit-tests:
    {{bun}} scripts/exit-tests.ts

# 웹 가격표 asOf 90일 검사: 오래된 항목을 출력만 하고 종료코드는 0 (L2.web.plan B5)
[group('local')]
web-pricing:
    cd packages/cap-web && {{bun}} run web-pricing

# 데스크톱 사이드카 빌드 <triple|host>: bun build --compile --minify --bytecode, 크기 상한 검사 (scripts/build-sidecar.ts). --no-bytecode, --list는 `just desktop-sidecar host --no-bytecode`처럼 붙인다
[group('local')]
desktop-sidecar triple *flags:
    {{bun}} scripts/build-sidecar.ts {{triple}} {{flags}}

# 릴리즈 아카이브 빌드 <triple|host> [--version x.y.z] [--binaries-dir 폴더] [--no-build]
[group('local')]
release-archive triple *flags:
    {{bun}} scripts/release.ts {{triple}} {{flags}}

# 릴리즈 스모크(X11): 이 기기의 릴리즈를 빌드해 풀고 점검한다. 환경 변수 FRESNEL_RELEASE_VERSION, FRESNEL_RELEASE_OUT
[group('local')]
release-smoke:
    scripts/release-smoke.sh

# 데스크톱 화면 번들 (bun build → apps/desktop/dist/ui). 인자 dev는 불변식 검사를 켠 개발 빌드. just verify 밖
[group('local')]
desktop-ui mode="release":
    {{bun}} run --cwd apps/desktop {{ if mode == "dev" { "build:ui:dev" } else { "build:ui" } }}

# 데스크톱 개발 실행: 셸을 번들하고 electron으로 띄운다. 화면은 `just desktop-ui`, 사이드카는 `just desktop-sidecar host`를 먼저 해 둔다(없으면 종료코드 2). 개발 실행이라 inspect 소켓(`<로그 폴더>/inspect.sock`, FRESNEL_DESKTOP_INSPECT=1)이 켜진다. just verify 밖
[group('local')]
desktop-run:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f apps/desktop/dist/ui/index.html ] || { echo "화면 번들이 없다: just desktop-ui" >&2; exit 2; }
    ls apps/desktop/dist/sidecar/fresnel-* >/dev/null 2>&1 || { echo "사이드카가 없다: just desktop-sidecar host" >&2; exit 2; }
    {{bun}} run --cwd apps/desktop-shell build
    cd apps/desktop-shell && FRESNEL_DESKTOP_INSPECT=1 exec node_modules/.bin/electron .

# 묶은 Electron 앱 Fresnel.app(macOS arm64) 만들기(전환 3단계): 셸 번들 뒤 @electron/packager로 묶는다. 화면 번들(`just desktop-ui`)과 사이드카(`just desktop-sidecar host`)가 없으면 종료코드 2. Resources에 화면, 엔진, 기본 플러그인(default-plugins/, 릴리스와 같은 목록), 트레이 아이콘, licenses/(Electron, Chromium, npm 고지)가 들어가고 크기는 마지막 줄에 나온다. 개발용 환경 변수는 묶은 앱에서 꺼져 있다. 출력 apps/desktop-shell/dist-app/. just verify 밖
[group('local')]
desktop-build-electron:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f apps/desktop/dist/ui/index.html ] || { echo "화면 번들이 없다: just desktop-ui" >&2; exit 2; }
    ls apps/desktop/dist/sidecar/fresnel-aarch64-apple-darwin >/dev/null 2>&1 || { echo "사이드카가 없다: just desktop-sidecar host" >&2; exit 2; }
    # bun install 뒤 electron postinstall이 안 돌아 바이너리가 없으면 직접 푼다(받기는 electron 패키지의 install.js가 한다. 네트워크 실패는 종료코드 2)
    [ -f apps/desktop-shell/node_modules/electron/dist/LICENSE ] || { echo "electron 바이너리가 없어 푼다: node install.js" >&2; (cd apps/desktop-shell/node_modules/electron && node install.js) || { echo "electron 바이너리를 풀지 못했다(네트워크?). 직접: cd apps/desktop-shell/node_modules/electron && node install.js" >&2; exit 2; }; }
    {{bun}} run --cwd apps/desktop-shell build
    # 엔진 사이드카(Bun, host, cli) 고지: package.ts가 Resources/licenses/에 넣는다(process 실행은 L0 소유라 여기서 만든다)
    {{bun}} scripts/notices.ts --out apps/desktop-shell/dist/engine-notices.txt
    # 기본 플러그인(릴리스 아카이브와 같은 목록, scripts/release-bundle.json): 개발 빌드도 같은 단계를 거친다. package.ts가 Resources/default-plugins/에 넣는다
    {{bun}} scripts/default-plugins.ts --out apps/desktop-shell/dist/default-plugins
    {{bun}} run --cwd apps/desktop-shell package

# Fresnel.app 서명과 공증(헬퍼 앱, 프레임워크, 사이드카를 안쪽부터 하드닝 런타임과 entitlements로 서명). Apple 시크릿 여섯 개가 없으면 서명 없이 UNSIGNED를 출력하고 종료코드 0(릴리스 태그면 1). 인자 --adhoc는 로컬 구조 점검용 임시 서명(릴리스 아님). 시크릿 값은 만들지도 출력하지도 않는다 (scripts/electron-sign.sh)
[group('local')]
desktop-sign-electron *flags:
    bash scripts/electron-sign.sh {{flags}} apps/desktop-shell/dist-app/Fresnel-darwin-arm64/Fresnel.app

# 묶은 앱 실행 스모크: 깨끗한 홈에서 Fresnel.app을 띄워 구조, 창 위치 복원, 첫 화면, 엔진 연결, 트레이, inspect 꺼짐, 두 번째 실행, 종료를 확인한다. macOS 화면 있는 로그인 환경 필요(없으면 종료코드 2) (scripts/electron-smoke.ts)
[group('local')]
desktop-smoke-electron:
    bash ../scripts/guard.sh run -- {{bun}} scripts/electron-smoke.ts apps/desktop-shell/dist-app/Fresnel-darwin-arm64/Fresnel.app

# Electron 셸 npm 고지(apps/desktop-shell/resources/THIRD-PARTY-NOTICES-SHELL.txt): 인자 없으면 다시 쓰고, --check면 커밋된 파일이 의존과 맞는지만 본다(다르면 종료코드 1). 앱에는 Resources/licenses/로 들어간다 (scripts/shell-notices.ts)
[group('local')]
desktop-notices-electron *flags:
    {{bun}} scripts/shell-notices.ts {{flags}}

# Electron 릴리즈 묶음: 화면, 사이드카, 셸, Fresnel.app, 서명(시크릿 없으면 UNSIGNED), Fresnel-<version>-arm64.zip과 .sha256을 FRESNEL_RELEASE_OUT(기본 dist/release-electron)에 만든다. `release-archive`는 CLI 릴리즈 아카이브라 그대로다. macOS arm64만 (scripts/release-electron.sh)
[group('local')]
release-archive-electron:
    scripts/release-electron.sh

# Electron 릴리즈 스모크: release-archive-electron에 묶은 앱 실행 스모크(`desktop-smoke-electron`)를 더한다. CI macOS job이 돈다
[group('local')]
release-smoke-electron:
    scripts/release-electron.sh --smoke

# Electron 셸 단위 시험(bun test, electron 없이 가짜 ctx로 돈다)
[group('local')]
desktop-shell-test:
    {{bun}} run --cwd apps/desktop-shell test

# 실제 provider로 모델 테이프 녹화 <scenario>: 비용이 들어 --yes 없이는 계획만 보이고 종료코드 3 (scripts/tape-record.ts, D-e)
[group('local')]
tape-record scenario *flags:
    {{bun}} scripts/tape-record.ts {{scenario}} {{flags}}

# 속도 기준선: 콜드 스타트(CLI, 사이드카). --first-token은 실제 모델 호출이라 --yes 없이는 종료코드 3 (scripts/benchmark.ts, ADR-0012)
[group('local')]
benchmark *flags:
    bash ../scripts/guard.sh run -- {{bun}} scripts/benchmark.ts {{flags}}

# 데스크톱 속도·크기(Y17): size, startup(창 띄워 첫 화면·유휴 메모리, macOS 전용, GUI 없으면 종료코드 2), frame(77개 Orbit CPU), trace(계측 켬·끔 Turn 비용), all. 실제 모델 호출 없음 (scripts/desktop-benchmark.ts)
[group('local')]
desktop-benchmark *flags:
    bash ../scripts/guard.sh run -- {{bun}} scripts/desktop-benchmark.ts {{flags}}

# 서버 측정 결과의 예산 판정: 예산이 사용자 결정 대기면 통과, 넘으면 실패, --strict면 대기도 실패 (scripts/benchmark-gate.ts)
[group('local')]
benchmark-gate *flags:
    bash ../scripts/guard.sh run -- bash -c '{{bun}} scripts/benchmark-server.ts --json | {{bun}} scripts/benchmark-gate.ts {{flags}}'

